{
  "name": "@solis/telemetry-worker",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "main": "./dist/main.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-schema.mjs",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:unit": "vitest run",
    "test:integration": "vitest run --passWithNoTests",
    "publish:synthetic": "node scripts/publish-synthetic.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "3.1095.0",
    "@solis/config": "workspace:*",
    "@solis/database": "workspace:*",
    "@solis/observability": "workspace:*",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
