{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.solis-iaos.example/mqtt/telemetry-envelope.v1.schema.json",
  "title": "SOLIS IAOS Telemetry Envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "messageId",
    "gatewayId",
    "sessionId",
    "sequence",
    "sourceTime",
    "clockStatus",
    "configVersion",
    "samples"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "messageId": { "type": "string", "format": "uuid" },
    "gatewayId": { "type": "string", "format": "uuid" },
    "sessionId": { "type": "string", "format": "uuid" },
    "sequence": { "type": "integer", "minimum": 0 },
    "sourceTime": { "type": "string", "format": "date-time" },
    "clockStatus": {
      "type": "string",
      "enum": ["SYNCED", "UNSYNCED", "UNKNOWN"]
    },
    "configVersion": { "type": "integer", "minimum": 1 },
    "samples": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "items": { "$ref": "#/$defs/sample" }
    }
  },
  "$defs": {
    "sample": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sampleIndex",
        "variableId",
        "mappingId",
        "dataType",
        "quality",
        "qualityDetail"
      ],
      "properties": {
        "sampleIndex": { "type": "integer", "minimum": 0, "maximum": 499 },
        "variableId": { "type": "string", "format": "uuid" },
        "mappingId": { "type": "string", "format": "uuid" },
        "offsetMs": { "type": "integer", "minimum": -86400000, "maximum": 86400000 },
        "dataType": {
          "type": "string",
          "enum": ["BOOLEAN", "INT64", "FLOAT64", "STRING"]
        },
        "value": {},
        "unitCode": { "type": "string", "minLength": 1, "maxLength": 32 },
        "quality": {
          "type": "string",
          "enum": ["GOOD", "UNCERTAIN", "BAD", "NO_DATA"]
        },
        "qualityDetail": {
          "type": "string",
          "enum": [
            "OK",
            "OUT_OF_RANGE",
            "SENSOR_FAILURE",
            "COMM_FAILURE",
            "STALE_SOURCE",
            "CLOCK_UNSYNCED",
            "MAPPING_ERROR",
            "MANUAL_SUBSTITUTE",
            "NO_SAMPLE"
          ]
        }
      },
      "allOf": [
        {
          "if": { "properties": { "quality": { "const": "NO_DATA" } } },
          "then": { "not": { "required": ["value"] } },
          "else": { "required": ["value"] }
        },
        {
          "if": { "properties": { "dataType": { "const": "BOOLEAN" } } },
          "then": { "properties": { "value": { "type": "boolean" } } }
        },
        {
          "if": { "properties": { "dataType": { "const": "INT64" } } },
          "then": {
            "properties": {
              "value": {
                "type": "string",
                "pattern": "^-?[0-9]{1,19}$"
              }
            }
          }
        },
        {
          "if": { "properties": { "dataType": { "const": "FLOAT64" } } },
          "then": { "properties": { "value": { "type": "number" } } }
        },
        {
          "if": { "properties": { "dataType": { "const": "STRING" } } },
          "then": {
            "properties": { "value": { "type": "string", "maxLength": 256 } }
          }
        }
      ]
    }
  }
}
