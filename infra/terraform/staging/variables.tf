variable "aws_region" {
  description = "AWS region approved by ADR-036."
  type        = string
  default     = "sa-east-1"

  validation {
    condition     = var.aws_region == "sa-east-1"
    error_message = "Baseline V1.2 authorizes only sa-east-1."
  }
}

variable "environment" {
  description = "Deployment environment."
  type        = string
  default     = "staging"

  validation {
    condition     = var.environment == "staging"
    error_message = "This landing zone is restricted to synthetic staging."
  }
}

variable "project_name" {
  description = "Resource name prefix."
  type        = string
  default     = "solis-iaos"
}

variable "vpc_cidr" {
  description = "Staging VPC CIDR."
  type        = string
  default     = "10.42.0.0/16"
}

variable "api_certificate_arn" {
  description = "ACM certificate ARN in sa-east-1 for the staging API."
  type        = string
}

variable "api_hostname" {
  description = "DNS hostname covered by api_certificate_arn."
  type        = string

  validation {
    condition     = length(trimspace(var.api_hostname)) > 3
    error_message = "api_hostname must be a non-empty DNS hostname."
  }
}

variable "route53_zone_id" {
  description = "Route 53 hosted zone that owns api_hostname."
  type        = string
}

variable "api_image" {
  description = "Immutable ECR API image reference."
  type        = string
  default     = ""

  validation {
    condition     = var.api_image == "" || can(regex("@sha256:[0-9a-f]{64}$", var.api_image))
    error_message = "api_image must be an immutable sha256 digest reference."
  }
}

variable "worker_image" {
  description = "Immutable ECR Telemetry Worker image reference."
  type        = string
  default     = ""

  validation {
    condition     = var.worker_image == "" || can(regex("@sha256:[0-9a-f]{64}$", var.worker_image))
    error_message = "worker_image must be an immutable sha256 digest reference."
  }
}

variable "simulator_image" {
  description = "Immutable ECR synthetic simulator image reference."
  type        = string
  default     = ""

  validation {
    condition     = var.simulator_image == "" || can(regex("@sha256:[0-9a-f]{64}$", var.simulator_image))
    error_message = "simulator_image must be an immutable sha256 digest reference."
  }
}

variable "deploy_services" {
  description = "Creates ECS task definitions and services only after immutable images exist."
  type        = bool
  default     = false

  validation {
    condition = !var.deploy_services || (
      can(regex("@sha256:[0-9a-f]{64}$", var.api_image)) &&
      can(regex("@sha256:[0-9a-f]{64}$", var.worker_image)) &&
      can(regex("@sha256:[0-9a-f]{64}$", var.simulator_image))
    )
    error_message = "All three digest image references are required when deploy_services=true."
  }
}

variable "database_name" {
  description = "PostgreSQL database name."
  type        = string
  default     = "solis_iaos"
}

variable "database_username" {
  description = "RDS managed master username; password is generated by RDS."
  type        = string
  default     = "solis_owner"
}

variable "alarm_email" {
  description = "Optional operations mailbox used after topic subscription confirmation."
  type        = string
  default     = ""
}
