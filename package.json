{
  "name": "solis-iaos",
  "version": "0.3.0",
  "private": true,
  "description": "SOLIS IAOS Foundation plus V0.3 local telemetry vertical slice",
  "license": "UNLICENSED",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=24.14.0 <25",
    "pnpm": ">=11.7.0 <12"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "node tools/scripts/dev.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "turbo run typecheck",
    "test": "pnpm test:unit && pnpm test:integration",
    "test:unit": "turbo run test:unit",
    "test:integration": "turbo run test:integration",
    "boundaries": "depcruise --config dependency-cruiser.cjs --exclude '(^|/)dist/' apps packages",
    "contracts:validate": "pnpm --filter @solis/contracts validate",
    "contracts:compat": "node tools/scripts/check-contract-sync.mjs",
    "db:schema:sync": "node tools/scripts/check-schema-sync.mjs",
    "db:migrate": "pnpm --filter @solis/database migrate",
    "db:migrate:up": "pnpm --filter @solis/database migrate up",
    "db:migrate:down": "pnpm --filter @solis/database migrate down",
    "db:status": "pnpm --filter @solis/database migrate status",
    "db:rls:static": "node tools/scripts/check-rls-sql.mjs",
    "local:up": "docker compose -f infra/local/compose.yaml up -d --wait",
    "local:apps:up": "docker compose -f infra/local/compose.yaml --profile apps up -d --build --wait",
    "local:start": "pnpm local:up && pnpm db:migrate:up && pnpm local:apps:up",
    "local:logs": "docker compose -f infra/local/compose.yaml --profile apps logs --no-color",
    "local:down": "docker compose -f infra/local/compose.yaml down",
    "local:reset": "docker compose -f infra/local/compose.yaml --profile apps down -v --remove-orphans",
    "local:smoke": "node tools/scripts/local-smoke.mjs",
    "mvp:config": "docker compose --env-file .env.mvp -f infra/mvp/compose.yaml config --quiet",
    "mvp:up": "docker compose --env-file .env.mvp -f infra/mvp/compose.yaml up -d --build --wait",
    "mvp:ps": "docker compose --env-file .env.mvp -f infra/mvp/compose.yaml ps",
    "mvp:logs": "docker compose --env-file .env.mvp -f infra/mvp/compose.yaml logs --no-color --tail=200",
    "mvp:down": "docker compose --env-file .env.mvp -f infra/mvp/compose.yaml down",
    "mvp:reset": "docker compose --env-file .env.mvp -f infra/mvp/compose.yaml down -v --remove-orphans",
    "sprint0b:preflight": "node tools/scripts/sprint-0b.mjs preflight",
    "sprint0b:static": "node tools/scripts/sprint-0b.mjs static",
    "sprint0b:local": "node tools/scripts/sprint-0b.mjs local",
    "sprint0b:terraform": "node tools/scripts/sprint-0b.mjs terraform",
    "sprint0b:security": "node tools/scripts/sprint-0b.mjs security",
    "sprint0b": "node tools/scripts/sprint-0b.mjs all",
    "security:secrets": "secretlint \"**/*\"",
    "security:audit": "pnpm audit --audit-level high",
    "sbom": "node tools/scripts/generate-sbom.mjs",
    "checksums": "node tools/scripts/generate-checksums.mjs",
    "mvp:check": "node tools/scripts/check-mvp.mjs",
    "ci": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm boundaries && pnpm contracts:validate && pnpm contracts:compat && pnpm db:schema:sync && pnpm db:rls:static && pnpm test:unit && pnpm mvp:check && pnpm build"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@secretlint/quick-start": "13.0.4",
    "@types/node": "24.13.3",
    "dependency-cruiser": "18.1.0",
    "eslint": "10.8.0",
    "globals": "17.8.0",
    "prettier": "3.9.6",
    "secretlint": "13.0.4",
    "turbo": "2.10.7",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.10"
  }
}
